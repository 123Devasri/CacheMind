# ==============================================================================
# CacheMind - Git Ignore Configuration
# ==============================================================================

# Byte-compiled / Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment files & secret keys (NEVER commit secrets!)
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.key
*.pem
*.cert

# Node / Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Unit test & test runner caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# SQLite databases & runtime persistence
*.sqlite
*.sqlite3
backend/cache_governance.db

# Logs & scratch files
*.log
*.tmp
*.bak

# IDE & OS-specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Type checker & linter caches
.mypy_cache/
.ruff_cache/
.pyre/
