# CacheMind - Governed Semantic Policy Assistant Environment Configuration

# Application Settings
PROJECT_NAME="Governed Semantic Cache"
ENV="development"
API_V1_STR="/api"

# Database Configuration (SQLite default)
DATABASE_URL="sqlite:///cache_governance.db"

# Pre-trained Sentence Transformer
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# Default Retrieval & Governance Thresholds
DEFAULT_CACHE_THRESHOLD=0.50
DEFAULT_MIN_COSINE_SIM=0.65
DEFAULT_TOP_K=5
TARGET_FHR=0.01
CONFIDENCE_LEVEL=0.95
CACHE_EXPIRY_DAYS=90

# Grounding & Inference Providers
FALLBACK_PROVIDER="grounded_company_policy_engine"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GROK_API_KEY=""
