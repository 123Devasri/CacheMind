# CacheMind: Governed Semantic Cache for Enterprise AI Assistants

# Application Settings
PROJECT_NAME="CacheMind"
ENV="development"
API_V1_STR="/api"

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL="sqlite:///cache_governance.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/cachemind"

# Fixed Pre-trained Sentence Transformer
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# Governance & Statistical Safety Thresholds
DEFAULT_CACHE_THRESHOLD=0.50
DEFAULT_MIN_COSINE_SIM=0.65
DEFAULT_TOP_K=5
TARGET_FHR=0.01
CONFIDENCE_LEVEL=0.95
CACHE_EXPIRY_DAYS=90

# Answer Service Grounding & External LLMs
FALLBACK_PROVIDER="grok_api" # "grok_api" or "grounded_company_policy_engine"

# Official xAI Grok API Configuration (Required for Grok LLM inference)
XAI_API_KEY="" # Enter your xAI API Key (e.g. xai-...)
XAI_MODEL="grok-2-latest" # Supported: grok-2-latest, grok-2-1212, grok-beta
XAI_BASE_URL="https://api.x.ai/v1"
GROK_API_KEY="" # Optional alias for XAI_API_KEY

# Optional OpenAI Fallback
OPENAI_API_KEY="" # Optional: OpenAI API Key
OPENAI_MODEL="gpt-4o-mini"
