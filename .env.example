# Governed Semantic Cache for Enterprise AI Assistants

# Application Settings
PROJECT_NAME="Governed Semantic Cache"
ENV="development"
API_V1_STR="/api"

# Database Configuration (SQLite by default, configurable for PostgreSQL)
DATABASE_URL="sqlite:///cache_governance.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/semantic_cache"

# Pre-trained Sentence Transformer
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# Default Retrieval & Governance Thresholds
DEFAULT_CACHE_THRESHOLD=0.60
DEFAULT_MIN_COSINE_SIM=0.65
DEFAULT_TOP_K=5
TARGET_FHR=0.01
CONFIDENCE_LEVEL=0.95
CACHE_EXPIRY_DAYS=90

# Fallback Provider Interface
FALLBACK_PROVIDER="local_mock" # Options: "local_mock" or "openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
